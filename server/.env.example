# Skopiuj na serwerze do /etc/amicare-api.env i ustaw chmod 600.
# Tego pliku z prawdziwym hasłem NIGDY nie commituj.
SMTP_HOST=smtp.amicare.pl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=formularz@amicare.pl
SMTP_PASS=
MAIL_FROM="Formularz Amicare" <formularz@amicare.pl>
PORT=3000

# Puste = front i API na tej samej domenie (zalecane).
# Jeśli front stoi gdzie indziej, wpisz jego adres, np. https://amicare.pl
CORS_ORIGINS=
