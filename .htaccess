  RewriteRule ^amicare/badania-kliniczne/obecnie-prowadzone-badania-kliniczne/lodz/urologia/jednostka-chorobowa-popromienne-zapalenie-pecherza/?$ /badania-kliniczne [R=301,L]
  RewriteRule ^amicare/swiatowy-dzien-bez-tytoniu/?$ - [G,L]
