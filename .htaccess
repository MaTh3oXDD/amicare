  RewriteRule ^wp_jac_slide/slide-01/?$ - [G,L]
  RewriteRule ^wp_jac_slide/slide-02/?$ - [G,L]
  # /wspolpraca/ -> /wspolpraca (obsluguje ogolna regula obcinajaca ukosnik)
  RewriteRule ^wspolpracujemy/?$ /o-nas/wspolpracujemy [R=301,L]
  # >>> PRZEKIEROWANIA-KONIEC

  # Jedna konwencja adresu: bez ukośnika na końcu, zgodnie z canonicalem.
  # Musi stać PO regułach dla starych adresów WordPressa - one kończą się ukośnikiem.
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Build z prerenderem daje katalog na trasę: /cennik -> cennik/index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  # Adres spoza listy tras kończy się tutaj: żadnej reguły już nie ma, więc
  # Apache oddaje ErrorDocument niżej z kodem 404.
  #
  # Nie kierujemy go 301 na stronę główną. Stare adresy WordPressa mają wyżej
  # własne, konkretne cele; wszystko poza tą listą to naprawdę nieistniejąca
  # strona. Masowe 301 na "/" Google czyta jak soft 404 i wyrzuca te adresy
  # z indeksu tak samo, tracąc przy okazji sygnał, że serwis ma czyste 404.
</IfModule>

# Adres spoza listy tras ma zwrócić prawdziwe 404, nie stronę główną z kodem 200.
# Kopię strony błędu tworzy scripts/pages-404.mjs.
ErrorDocument 404 /404.html

# Nagłówki bezpieczeństwa - formularze zbierają dane pacjentów.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Pliki z hashem w nazwie - cache na rok
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
