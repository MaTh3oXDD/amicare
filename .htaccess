# Apache: serwowanie prerenderowanej strony + proxy formularzy.
# Trafia do folderu www razem z resztą plików strony.

# Apache sam dokleja ukośnik do nazwy istniejącego katalogu (/cennik -> /cennik/),
# a reguła niżej ten ukośnik zdejmuje. Bez wyłączenia tego zachowania obie
# strony przerzucają się adresem w nieskończoność i podstrona nigdy się nie
# otwiera. Katalogi obsługuje reguła kierująca na index.html na końcu pliku.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Bez tego /cennik mogłoby trafić na dowolny plik o tej nazwie, z inną końcówką.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Wymuś HTTPS - formularze zbierają dane pacjentów
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # /api/... zostaw backendowi, nie przepisuj
  RewriteRule ^api/ - [L]

  # Przekierowania ze starych adresów WordPressa muszą zadziałać przed
  # serwowaniem plików. Blok niżej wstawia `npm run redirects` - nie edytuj go
  # ręcznie i nie ruszaj znaczników, bo skrypt podmienia wszystko między nimi.
  # Bez tego bloku build nadpisuje .htaccess na serwerze i kasuje mapę 301.
  # >>> PRZEKIEROWANIA-START
  # 181 regul wygenerowanych przez scripts/redirects.mjs.
  RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^wp-(content|includes|admin)/ - [G,L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php)$ - [G,L]
  RewriteRule ^amicare/amicare-specjalizacje-kompleksowe-badania-i-opieka-zdrowotna/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/?$ /badania-diagnostyczne [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/badanie-ekg/?$ /badania-diagnostyczne/badanie-ekg [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/badanie-holtera/?$ /badania-diagnostyczne/badanie-holtera [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/badanie-usg/?$ /badania-diagnostyczne/badanie-usg [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/diagnostyka-bolu-brzucha/?$ /badania-diagnostyczne/diagnostyka-bolu-brzucha [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/gastroskopia/?$ /pracownia-endoskopii/gastroskopia [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/kolonoskopia/?$ /pracownia-endoskopii/kolonoskopia [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/leczenie-biologiczne/?$ /badania-diagnostyczne/leczenie-biologiczne [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/pobranie-krwi/?$ /badania-diagnostyczne/pobranie-krwi [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/pomiar-masy-ciala/?$ /badania-diagnostyczne/pomiar-masy-ciala [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/pomiar-tetna-i-cisnienia/?$ /badania-diagnostyczne/pomiar-tetna-i-cisnienia [R=301,L]
  RewriteRule ^amicare/badania-diagnostyczne/spirometria/?$ /badania-diagnostyczne [R=301,L]
  RewriteRule ^amicare/badania-kliniczne/?$ /badania-kliniczne [R=301,L]
