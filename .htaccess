  # /o-nas/zespol/lek-karolina-kabot/ -> /o-nas/zespol/lek-karolina-kabot (obsluguje ogolna regula obcinajaca ukosnik)
  # /o-nas/zespol/lek-leszek-weber/ -> /o-nas/zespol/lek-leszek-weber (obsluguje ogolna regula obcinajaca ukosnik)
  RewriteRule ^o-nas/zespol/pielegniarki/?$ /o-nas/zespol [R=301,L]
  RewriteRule ^o-nas/zespol/pielegniarki/angelika-jurkiewicz/?$ /o-nas/zespol/angelika-jurkiewicz [R=301,L]
  RewriteRule ^o-nas/zespol/pielegniarki/barbara-estal/?$ /o-nas/zespol [R=301,L]
  RewriteRule ^o-nas/zespol/pielegniarki/martyna-janczak/?$ /o-nas/zespol [R=301,L]
  RewriteRule ^o-nas/zespol/pielegniarki/miroslawa-kazmierczak/?$ /o-nas/zespol [R=301,L]
  # /o-nas/zespol/prof-dr-hab-n-med-joanna-jerzynska/ -> /o-nas/zespol/prof-dr-hab-n-med-joanna-jerzynska (obsluguje ogolna regula obcinajaca ukosnik)
  RewriteRule ^o-nas/zespol/zespol-pielegniarski/?$ /o-nas/zespol [R=301,L]
  RewriteRule ^o-nas/zespol/zespol-pielegniarski/angelika-jurkiewicz/?$ /o-nas/zespol/angelika-jurkiewicz [R=301,L]
  RewriteRule ^o-nas/zespol/zespol-pielegniarski/hubert-sadowski/?$ /o-nas/zespol/hubert-sadowski [R=301,L]
  RewriteRule ^oferta/?$ /konsultacje-specjalistyczne [R=301,L]
  # /pracownia-endoskopii/ -> /pracownia-endoskopii (obsluguje ogolna regula obcinajaca ukosnik)
  RewriteRule ^prawa-pacjenta-w-badaniach-klinicznych/?$ /badania-kliniczne [R=301,L]
  RewriteRule ^specjalizacja/alergologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/anestezjologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/chirurgia/?$ /konsultacje-specjalistyczne/chirurgia [R=301,L]
  RewriteRule ^specjalizacja/choroby-wewnetrzne/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/choroby-zakazne/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/dermatologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/diabetologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/dietetyka/?$ /konsultacje-specjalistyczne/dietetyka [R=301,L]
  RewriteRule ^specjalizacja/endokrynologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/epileptologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/farmakologia-kliniczna/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/gastroenterologia-pl/?$ /konsultacje-specjalistyczne/gastroenterologia [R=301,L]
  RewriteRule ^specjalizacja/kardiologia/?$ /konsultacje-specjalistyczne/kardiologia [R=301,L]
  RewriteRule ^specjalizacja/laryngologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/neurologia-dziecieca/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/neurologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/onkologia/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/pediatria/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/poz/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/proktologia/?$ /konsultacje-specjalistyczne/proktologia [R=301,L]
  RewriteRule ^specjalizacja/psychiatria/?$ /konsultacje-specjalistyczne [R=301,L]
  RewriteRule ^specjalizacja/psychologia/?$ /konsultacje-specjalistyczne/psychologia [R=301,L]
  RewriteRule ^specjalizacja/reumatologia/?$ /konsultacje-specjalistyczne/reumatologia [R=301,L]
