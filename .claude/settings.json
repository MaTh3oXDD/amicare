{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "graphify update . 2>/dev/null || true",
            "statusMessage": "Updating knowledge graph...",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -q '^git commit' && graphify update . 2>/dev/null || true",
            "statusMessage": "Updating knowledge graph after commit...",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
